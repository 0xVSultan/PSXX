# Writes the global symbols of an ELF file as a linker script of PROVIDE() lines, so that an overlay can be linked against a base image at fixed addresses:
#   cmake -DNM=<nm> -DELF=<base.elf> -DOUT=<base_syms.ld> -P gen_syms.cmake
# (-Wl,--just-symbols=<base.elf> does not work for the calls: ld reads the addresses of an ELF32 MIPS file sign extended, 0xffffffff80110650, and
# the check of the 26 bit jump (the top four bits of the target have to be the ones of the call) fails. The 8 digit values of a script do not.)
# PROVIDE: a symbol is taken from here only if no object of the overlay defines it.
execute_process(COMMAND ${NM} -f posix -g --defined-only -n ${ELF} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
if(_rc)
    message(FATAL_ERROR "nm failed on ${ELF}")
endif()
string(REPLACE "\n" ";" _lines "${_out}")
set(_text "/* generated by gen_syms.cmake from ${ELF}: do not edit */\n")
foreach(_l IN LISTS _lines)
    if(_l MATCHES "^([A-Za-z_][A-Za-z0-9_.]*) [A-Za-z] [0-9a-f]*([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])( |$)")
        set(_name ${CMAKE_MATCH_1})
        set(_addr ${CMAKE_MATCH_2})
        if(_name MATCHES "^__(u|)(div|mod)di3$|^__(ashl|lshr|ucmp|cmp)di[23]$")
            string(APPEND _text "${_name} = 0x${_addr};\n")        # the compiler support routines: a definition, not a PROVIDE, so that libgcc does not bring its own copy into the overlay
        else()
            string(APPEND _text "PROVIDE(${_name} = 0x${_addr});\n")
        endif()
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")

# The export list of an overlay: every symbol that its objects use but none of them defines has to be in the base image, even if the base itself never calls it (the linker drops
# unused functions). Written as a linker script of EXTERN() commands that is an input of the link of the base:
#   cmake -DNM=<nm> -DREADELF=<readelf> "-DOBJS=<o1@@o2@@...>" -DOUT=<exports.ld> [-DRSP=<exports.rsp>] -P gen_exports.cmake
# RSP: the same list as -u options for the linker (-Wl,@exports.rsp): a link with LTO does not keep what a linker script names with EXTERN.
# "Use" means a relocation against the symbol: GCC leaves some undefined symbols in the symbol table that no code refers to (__divdi3 and __moddi3 of signer_app.c and xrp.c,
# a 64 bit division it planned and then did another way); exporting those kept 3 KB of libgcc in the base that nothing calls.
string(REPLACE "@@" ";" OBJS "${OBJS}")
if(NOT READELF)
    message(FATAL_ERROR "gen_exports.cmake: READELF is not set")
endif()
set(_undef "")
set(_def "")
set(_rel "")
foreach(_o IN LISTS OBJS)
    execute_process(COMMAND ${NM} -f posix -g ${_o} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
    if(_rc)
        message(FATAL_ERROR "nm failed on ${_o}")
    endif()
    string(REPLACE "\n" ";" _lines "${_out}")
    foreach(_l IN LISTS _lines)
        if(_l MATCHES "^([A-Za-z_][A-Za-z0-9_.$]*) ([A-Za-z]) ?")
            if(CMAKE_MATCH_2 STREQUAL "U")
                list(APPEND _undef ${CMAKE_MATCH_1})
            elseif(NOT CMAKE_MATCH_2 STREQUAL "w" AND NOT CMAKE_MATCH_2 STREQUAL "v")
                list(APPEND _def ${CMAKE_MATCH_1})
            endif()
        endif()
    endforeach()
    execute_process(COMMAND ${READELF} -rW ${_o} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)         # the lines: offset info type value name
    if(_rc)
        message(FATAL_ERROR "readelf failed on ${_o}")
    endif()
    string(REGEX MATCHALL "R_MIPS_[A-Z0-9_]+ +[0-9a-f]+ +[^ \r\n]+" _rels "${_out}")
    set(_names "")
    foreach(_r IN LISTS _rels)
        string(REGEX REPLACE "^.* " "" _r "${_r}")
        list(APPEND _names ${_r})
    endforeach()
    list(REMOVE_DUPLICATES _names)
    list(APPEND _rel ${_names})
endforeach()
list(REMOVE_DUPLICATES _undef)
list(REMOVE_ITEM _undef ${_def})
set(_used "")
foreach(_s IN LISTS _undef)
    if(_s IN_LIST _rel)
        list(APPEND _used ${_s})
    endif()
endforeach()
set(_undef ${_used})
# the compiler support routines (__udivdi3 ...) are stateless and the same in the base and in the overlays: the overlays use the copy of the base (the base keeps what they
# call) instead of linking their own, which was about 3 KB of every overlay (1.7 KB in the packages)
list(SORT _undef)
set(_text "/* generated by gen_exports.cmake: the symbols the overlay needs from the base. Do not edit. */\n")
set(_rsp "")
foreach(_s IN LISTS _undef)
    string(APPEND _text "EXTERN(${_s})\n")
    string(APPEND _rsp "-u ${_s}\n")
endforeach()
file(WRITE "${OUT}" "${_text}")
if(RSP)
    file(WRITE "${RSP}" "${_rsp}")
endif()
